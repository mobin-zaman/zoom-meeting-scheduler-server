# Copy this file to .env and fill in your own values.
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASS=your_db_password
DATABASE_PORT=3306
DATABASE_SYNC=true
DATABASE_NAME=zoom-meeting-scheduler

ZOOM_API_KEY=your_zoom_api_key
ZOOM_SECRET=your_zoom_secret

SSL_COMMERZ_STORE_ID=your_store_id
SSL_COMMERZ_STORE_PASSWD=your_store_password
SSL_COMMERZ_REFER=your_session_refer_id
SSL_COMMERZ_AMOUNT=1000
SSL_COMMERZ_IPN_URL=https://your-domain.com/payment-gateway

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

FILE_SAVE_DIRECTORY=/path/to/uploads

USER_BEARER_TOKEN_VALIDATION_ENDPOINT=https://your-forum.com/wp-json/jwt-auth/v1/token/validate

MAIL_HOST=smtp.example.com
MAIL_USER=user@example.com
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=noreply@example.com
MAIL_PORT=587

# Absolute path to the Firebase Admin SDK service-account JSON file (not committed).
FIREBASE_CREDENTIAL_PATH=/path/to/firebase-adminsdk.json